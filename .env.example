# Development settings for the local Docker database.
# Copy this file to .env (cp .env.example .env). Never commit .env.
# These are shared development defaults, not real credentials.

# PostgreSQL (container ada-postgres)
POSTGRES_DB=ada
POSTGRES_USER=ada
POSTGRES_PASSWORD=ada_dev
POSTGRES_HOST=localhost
# Host port. 5433 avoids clashing with a PostgreSQL installed on the machine (5432).
POSTGRES_PORT=5433

# pgAdmin (container ada-pgadmin) -> http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@ada.com
PGADMIN_DEFAULT_PASSWORD=admin_dev
PGADMIN_PORT=5050

# Puerto del servidor web de ADA -> http://localhost:8080
   SERVIDOR_PUERTO=8080